# ─── General ──────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
APP_ENV=development
APP_DEBUG=true

# ─── Database / queue ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agency:agency_secret@localhost:5433/agency_os
REDIS_URL=redis://localhost:6380/0
TASK_OUTBOX_DISPATCH_INTERVAL_SECONDS=2
TASK_OUTBOX_DISPATCH_BATCH=50
TASK_OUTBOX_STALE_SECONDS=300
TASK_OUTBOX_STALE_EXECUTION_SECONDS=1800

# ─── API / frontend ───────────────────────────────────
API_URL=http://api:8000
API_PORT=8010
NEXT_PUBLIC_API_URL=http://localhost:8010

# ─── Text generation (OpenAI-compatible endpoint) ─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6
LLM_MODEL_CANDIDATES=gpt-5.6
LLM_INPUT_COST_PER_1M_USD=0
LLM_OUTPUT_COST_PER_1M_USD=0
LLM_MODEL_PRICING_JSON={}

# ─── Model Router ─────────────────────────────────────
# off: default only; shadow: offline candidate trials; active: controlled live routing.
MODEL_ROUTER_MODE=shadow
MODEL_ROUTER_MIN_SAMPLES_PER_MODEL=10
MODEL_ROUTER_MIN_LIVE_SAMPLES=3
MODEL_ROUTER_MIN_DOWNSTREAM_SAMPLES=3
MODEL_ROUTER_QUALITY_FLOOR=0.84
MODEL_ROUTER_SHADOW_SAMPLE_RATE=0.05
MODEL_ROUTER_JUDGE_MODEL=
MODEL_ROUTER_EXPLORATION_RATE=0.10
MODEL_ROUTER_QUALITY_WEIGHT=0.65
MODEL_ROUTER_PERFORMANCE_WEIGHT=0.20
MODEL_ROUTER_LATENCY_WEIGHT=0.10
MODEL_ROUTER_COST_WEIGHT=0.05
# Materialized read model: routing never scans full project history synchronously.
MODEL_ROUTER_SNAPSHOT_TTL_SECONDS=300
# Durable refresh intents are deduplicated into small time buckets.
MODEL_ROUTER_REFRESH_DEDUPE_SECONDS=60

# ─── Project Knowledge Base / RAG ─────────────────────
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_TEXT_CHARS=2000000
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_CHUNK_CHARS=1400
KNOWLEDGE_CHUNK_OVERLAP=200

# ─── Live research ────────────────────────────────────
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
RESEARCH_MAX_RESULTS=5
RESEARCH_MIN_SCORE=0.45

# ─── Image generation / visual QA ─────────────────────
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1.5
IMAGE_SIZE=1024x1024
MEDIA_QUALITY_THRESHOLD=0.86
MAX_IMAGE_ATTEMPTS=2

# ─── Private object storage ───────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=contentfactory
S3_SECRET_KEY=contentfactory-secret
S3_REGION=us-east-1
S3_BUCKET=content-assets
MEDIA_URL_TTL_SECONDS=604800
MINIO_ROOT_USER=contentfactory
MINIO_ROOT_PASSWORD=contentfactory-secret

# ─── Quality gates ────────────────────────────────────
QUALITY_THRESHOLD=0.87
FACTUALITY_THRESHOLD=0.95
BRAND_VOICE_THRESHOLD=0.85
MAX_REVISION_ATTEMPTS=2

# ─── Autoposter handoff ───────────────────────────────
AUTOPOSTER_URL=
AUTOPOSTER_TOKEN=
PERFORMANCE_INGEST_TOKEN=
