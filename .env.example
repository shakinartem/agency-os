# ─── General ──────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
APP_ENV=development
APP_DEBUG=true

# ─── Database / queue ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agency:agency_secret@localhost:5433/agency_os
REDIS_URL=redis://localhost:6380/0

# ─── API / frontend ───────────────────────────────────
API_URL=http://api:8000
API_PORT=8010
NEXT_PUBLIC_API_URL=http://localhost:8010

# ─── Text generation (OpenAI-compatible endpoint) ─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6

# ─── Project Knowledge Base / RAG ─────────────────────
# Internal first-party material is parsed and chunked per project. Parsing is bounded
# for safety; production SaaS can later move complex parsing to an isolated worker.
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_TEXT_CHARS=2000000
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_CHUNK_CHARS=1400
KNOWLEDGE_CHUNK_OVERLAP=200

# ─── Live research ────────────────────────────────────
# Tavily Search is optional. Without a key, the research stage is explicitly marked skipped.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
RESEARCH_MAX_RESULTS=5
RESEARCH_MIN_SCORE=0.45

# ─── Image generation / visual QA ─────────────────────
# Defaults to ${LLM_BASE_URL}/images/generations when empty in the worker.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1.5
IMAGE_SIZE=1024x1024
MEDIA_QUALITY_THRESHOLD=0.86
MAX_IMAGE_ATTEMPTS=2

# ─── Private object storage (S3-compatible; MinIO locally) ────
# S3_ENDPOINT_URL is used by the worker to upload. S3_PUBLIC_ENDPOINT_URL is used only
# to sign browser/Autoposter-readable download URLs. Keep S3_PUBLIC_BASE_URL empty for
# private-by-default buckets; set it only when using a deliberate public CDN origin.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=contentfactory
S3_SECRET_KEY=contentfactory-secret
S3_REGION=us-east-1
S3_BUCKET=content-assets
MEDIA_URL_TTL_SECONDS=604800
MINIO_ROOT_USER=contentfactory
MINIO_ROOT_PASSWORD=contentfactory-secret

# ─── Quality gates ────────────────────────────────────
QUALITY_THRESHOLD=0.87
FACTUALITY_THRESHOLD=0.95
BRAND_VOICE_THRESHOLD=0.85
MAX_REVISION_ATTEMPTS=2

# ─── Autoposter handoff ───────────────────────────────
# Endpoint that accepts content-package/1.0 JSON. When empty, packages stay in the outbox.
AUTOPOSTER_URL=
AUTOPOSTER_TOKEN=
