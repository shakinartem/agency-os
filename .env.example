# ─── General ──────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
APP_ENV=development
APP_DEBUG=true

# ─── Database / queue ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agency:agency_secret@localhost:5433/agency_os
REDIS_URL=redis://localhost:6380/0

# ─── API / frontend ───────────────────────────────────
API_URL=http://api:8000
API_PORT=8010
NEXT_PUBLIC_API_URL=http://localhost:8010

# ─── Text generation (OpenAI-compatible endpoint) ─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6

# ─── Image generation ─────────────────────────────────
# Full image-generation endpoint URL. Leave empty to keep generated visual prompts in manual review.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1.5

# ─── Quality gates ────────────────────────────────────
QUALITY_THRESHOLD=0.87
FACTUALITY_THRESHOLD=0.95
BRAND_VOICE_THRESHOLD=0.85
MAX_REVISION_ATTEMPTS=2

# ─── Autoposter handoff ───────────────────────────────
# Endpoint that accepts content-package/1.0 JSON. When empty, packages stay in the outbox.
AUTOPOSTER_URL=
AUTOPOSTER_TOKEN=
