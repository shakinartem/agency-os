FROM python:3.12-slim

RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /app
COPY packages/database/pyproject.toml packages/database/
COPY apps/worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=app:app packages/ packages/
COPY --chown=app:app apps/worker/ apps/worker/
COPY --chown=app:app integrations/ integrations/
ENV PYTHONPATH=/app:/app/packages PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER app
CMD ["celery", "-A", "apps.worker.tasks.factory_worker", "worker", "--loglevel=info", "--include", "apps.worker.tasks.review_tasks,apps.worker.tasks.strategy_tasks,apps.worker.tasks.batch_tasks,apps.worker.tasks.dispatch_tasks,apps.worker.tasks.delivery_tasks,apps.worker.tasks.model_router_snapshot_tasks,apps.worker.tasks.model_router_runtime,apps.worker.tasks.model_router_prompt_epoch_runtime,apps.worker.tasks.prompt_experiment_runtime"]
